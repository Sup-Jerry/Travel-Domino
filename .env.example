# =============================
# Backend / Docker Compose
# =============================
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_JWT_SECRET
DATABASE_URL=postgres://travel:REPLACE_WITH_STRONG_DB_PASSWORD@localhost:5432/travel_auth
AUTH_ACCESS_TTL_SECONDS=7200
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_USE_STUB_PROVIDERS=false
SMS_PROVIDER=production

# =============================
# HarmonyOS signing injection
# =============================
SIGN_STORE_FILE=C:/path/to/traveldomino.p12
SIGN_STORE_PASSWORD=REPLACE_WITH_STRONG_STORE_PASSWORD
SIGN_KEY_ALIAS=T
SIGN_KEY_PASSWORD=REPLACE_WITH_STRONG_KEY_PASSWORD
SIGN_PROFILE_FILE=C:/path/to/travel_profile.p7b
SIGN_CERT_PATH=C:/path/to/travel_debug.cer

# =============================
# AppConfig injection
# =============================
AI_API_KEY=REPLACE_WITH_YOUR_AI_API_KEY
AMAP_WEB_API_KEY=REPLACE_WITH_YOUR_AMAP_WEB_API_KEY
AMAP_SDK_API_KEY=REPLACE_WITH_YOUR_AMAP_SDK_API_KEY
AUTH_API_BASE_URL=http://127.0.0.1:3000
