#!/usr/bin/env bash
set -euo pipefail

if command -v pwsh >/dev/null 2>&1; then
  PS_BIN="pwsh"
elif command -v powershell >/dev/null 2>&1; then
  PS_BIN="powershell"
else
  echo "[pre-push] PowerShell is required to run secret scan." >&2
  exit 1
fi

"$PS_BIN" -NoProfile -ExecutionPolicy Bypass -File scripts/ci/secret-scan.ps1 -Scope Repo
