#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

if command -v pwsh >/dev/null 2>&1; then
  PS_BIN="pwsh"
elif command -v powershell >/dev/null 2>&1; then
  PS_BIN="powershell"
else
  echo "[pre-push] PowerShell is required." >&2
  exit 1
fi

"$PS_BIN" -NoProfile -ExecutionPolicy Bypass -File "$repo_root/scripts/git-hooks/pre-push.ps1"
